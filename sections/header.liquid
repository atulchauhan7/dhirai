<header class="site-header {% if section.settings.show_announcement %}has-announcement{% endif %}" data-header>

<div class="site-header__inner">

  <!-- LEFT: Hamburger (mobile) + Logo -->
  <div class="site-header__brand">
    <button class="menu-toggle header-icon" aria-label="Menu" aria-expanded="false">
      <svg class="menu-toggle__open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <line x1="4" y1="7" x2="20" y2="7"/>
        <line x1="4" y1="12" x2="20" y2="12"/>
        <line x1="4" y1="17" x2="14" y2="17"/>
      </svg>
      <svg class="menu-toggle__close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:none">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
    <a href="{{ routes.root_url }}" class="site-header__logo">
      {% if section.settings.logo != blank %}
      <img src="{{ section.settings.logo | image_url: width: 200 }}" alt="{{ shop.name | escape }}" loading="eager" width="200" height="44">
      {% else %}
      <span class="logo-text" data-logo-text>{{ shop.name }}</span>
      {% endif %}
    </a>
  </div>

  <!-- CENTER: Desktop Inline Navigation -->
  <nav class="site-header__mainnav" role="navigation" aria-label="Main navigation">
    {% for link in linklists[section.settings.menu].links %}
    <div class="nav-item">
      <a href="{{ link.url }}"
         class="site-header__nav-link {% if link.active %}active{% endif %}"
         {% if link.url contains '/collections/' %}data-nav-collection-handle="{{ link.url | split: '/collections/' | last | split: '?' | first | split: '/' | first }}"{% endif %}
         {% if link.links.size > 0 %}
         data-nav-parent="true"
         aria-expanded="false"
         onclick="event.preventDefault();event.stopPropagation();var ni=this.closest('.nav-item'),mg=ni.querySelector('.mega-menu');if(!mg)return;var wasOpen=ni.classList.contains('is-open');document.querySelectorAll('.nav-item').forEach(function(o){o.classList.remove('is-open');var m=o.querySelector('.mega-menu');if(m)m.classList.remove('open');var a=o.querySelector('.site-header__nav-link[data-nav-parent]');if(a)a.setAttribute('aria-expanded','false');var ar=o.querySelector('.nav-arrow');if(ar)ar.style.transform=''});if(!wasOpen){ni.classList.add('is-open');mg.classList.add('open');this.setAttribute('aria-expanded','true');var aw=this.querySelector('.nav-arrow');if(aw)aw.style.transform='rotate(180deg)'}"
         {% endif %}>
        <span class="nav-link__text">{{ link.title }}</span>
        {% if link.links.size > 0 %}
        <svg class="nav-arrow" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        {% endif %}
      </a>
      {% if link.links.size > 0 %}
      <div class="mega-menu">
        <div class="mega-menu__grid">
          {% for child_link in link.links %}
          <div class="mega-menu__column">
            <a href="{{ child_link.url }}" class="mega-menu__column-title">{{ child_link.title }}</a>
            {% for grandchild in child_link.links %}
            <a href="{{ grandchild.url }}" class="mega-menu__link">{{ grandchild.title }}</a>
            {% endfor %}
          </div>
          {% endfor %}
        </div>
      </div>
      {% endif %}
    </div>
    {% endfor %}
  </nav>

  <!-- RIGHT: Action Icons -->
  <div class="site-header__actions">
    <a href="{{ routes.search_url }}" class="header-icon" aria-label="Search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="11" cy="11" r="8"/>
        <path d="M21 21l-4.35-4.35"/>
      </svg>
    </a>
    <a href="{{ routes.account_url }}" class="header-icon header-icon--desktop-only" aria-label="Account">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
        <circle cx="12" cy="7" r="4"/>
      </svg>
    </a>
    <button class="header-icon" data-wishlist-trigger aria-label="Wishlist">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
      </svg>
      <span class="wishlist-count-badge" style="display:none;"></span>
    </button>
    <button class="header-icon" data-cart-trigger aria-label="Cart">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
        <line x1="3" y1="6" x2="21" y2="6"/>
        <path d="M16 10a4 4 0 0 1-8 0"/>
      </svg>
      <span class="cart-count">{{ cart.item_count }}</span>
    </button>
  </div>

</div>

<!-- Inline Search Bar -->
<div class="header-search" data-header-search>
  <div class="header-search__inner">
    <form action="{{ routes.search_url }}" method="get" role="search" class="header-search__form">
      <input type="hidden" name="type" value="product">
      <svg class="header-search__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
      <input type="search" name="q" class="header-search__input" placeholder="Search for tees, dresses, coords..." autocomplete="off" aria-label="Search products">
      <button type="button" class="header-search__close" data-header-search-close aria-label="Close search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </form>
    <div class="header-search__tags">
      <a href="{{ routes.search_url }}?q=oversized+tee&type=product" class="header-search__tag">Oversized Tee</a>
      <a href="{{ routes.search_url }}?q=graphic+tee&type=product" class="header-search__tag">Graphic Tee</a>
      <a href="{{ routes.search_url }}?q=crop+top&type=product" class="header-search__tag">Crop Top</a>
      <a href="{{ routes.search_url }}?q=coord+set&type=product" class="header-search__tag">Coord Set</a>
      <a href="{{ routes.search_url }}?q=new+arrivals&type=product" class="header-search__tag">New Arrivals</a>
    </div>
  </div>
</div>

<!-- Mobile Slide-in Nav Drawer -->
<nav class="site-header__nav" role="navigation" aria-label="Mobile navigation">

  <!-- User greeting + close -->
  <div class="nav-mobile-header">
    <div class="nav-user-section">
      <div class="nav-user-avatar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="22" height="22"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </div>
      <div class="nav-user-info">
        <span class="nav-user-greeting">Hey There!</span>
        <a href="{{ routes.account_url }}" class="nav-user-login">Login / Sign Up</a>
      </div>
    </div>
    <button class="nav-mobile-close" aria-label="Close menu" data-nav-close>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  {% comment %} SHOP IN — Mobile category cards {% endcomment %}
  {% assign mobile_cats = section.blocks | where: 'type', 'mobile_category' %}
  {% if mobile_cats.size > 0 %}
  <p class="nav-section-label">SHOP IN</p>
  <div class="nav-mobile-categories">
    {% for block in mobile_cats %}
    <a href="{{ block.settings.link | default: '#' }}" class="nav-mobile-cat" {{ block.shopify_attributes }}>
      <div class="nav-mobile-cat__img-wrap">
        {% if block.settings.image != blank %}
        <img
          src="{{ block.settings.image | image_url: width: 200 }}"
          srcset="{{ block.settings.image | image_url: width: 100 }} 100w, {{ block.settings.image | image_url: width: 200 }} 200w"
          sizes="80px"
          alt="{{ block.settings.label | escape }}"
          loading="lazy"
          decoding="async"
          width="200"
          height="200"
        >
        {% else %}
        {{ 'collection-1' | placeholder_svg_tag: 'nav-mobile-cat__placeholder' }}
        {% endif %}
      </div>
      <span class="nav-mobile-cat__label">{{ block.settings.label }}</span>
    </a>
    {% endfor %}
  </div>
  {% endif %}

  <div class="nav-mobile-links">
    {% for link in linklists[section.settings.menu].links %}
    <div class="nav-item">
      <a href="{{ link.url }}" class="site-header__nav-link {% if link.active %}active{% endif %}" {% if link.url contains '/collections/' %}data-nav-collection-handle="{{ link.url | split: '/collections/' | last | split: '?' | first | split: '/' | first }}"{% endif %} {% if link.links.size > 0 %}data-nav-parent="true" aria-expanded="false" onclick="event.preventDefault();event.stopPropagation();var ni=this.closest('.nav-item'),mg=ni.querySelector('.mega-menu');if(!mg)return;var wasOpen=ni.classList.contains('is-open');document.querySelectorAll('.nav-item').forEach(function(o){o.classList.remove('is-open');var m=o.querySelector('.mega-menu');if(m)m.classList.remove('open');var a=o.querySelector('.site-header__nav-link[data-nav-parent]');if(a)a.setAttribute('aria-expanded','false');var ar=o.querySelector('.nav-arrow');if(ar)ar.style.transform=''});if(!wasOpen){ni.classList.add('is-open');mg.classList.add('open');this.setAttribute('aria-expanded','true');var aw=this.querySelector('.nav-arrow');if(aw)aw.style.transform='rotate(180deg)'}"{% endif %}>
        <span class="nav-link__inner">
          <span class="nav-link__thumb" style="display:none"></span>
          <span class="nav-link__text">{{ link.title }}</span>
        </span>
        {% if link.links.size > 0 %}
        <svg class="nav-arrow" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        {% endif %}
      </a>
      {% if link.links.size > 0 %}
      <div class="mega-menu">
        <div class="mega-menu__grid">
          {% for child_link in link.links %}
          <div class="mega-menu__column">
            <a href="{{ child_link.url }}" class="mega-menu__column-title">{{ child_link.title }}</a>
            {% for grandchild in child_link.links %}
            <a href="{{ grandchild.url }}" class="mega-menu__link">{{ grandchild.title }}</a>
            {% endfor %}
          </div>
          {% endfor %}
        </div>
      </div>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  <div class="nav-collections" id="nav-collections"></div>

  <!-- MY PROFILE quick tiles -->
  <p class="nav-section-label">MY PROFILE</p>
  <div class="nav-profile-tiles">
    <a href="{{ routes.account_url }}" class="nav-profile-tile">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      My Account
    </a>
    <a href="{{ routes.account_url }}/orders" class="nav-profile-tile">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
      My Orders
    </a>
    <a href="{{ routes.account_url }}" class="nav-profile-tile">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/><line x1="6" y1="15" x2="9" y2="15"/></svg>
      My Wallet
    </a>
    <button type="button" class="nav-profile-tile" data-wishlist-trigger>
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
      My Wishlist
    </button>
  </div>

  <!-- CONTACT US -->
  <p class="nav-section-label">CONTACT US</p>
  <div class="nav-contact-links">
    {% if linklists['footer'].links.size > 0 %}
      {% for link in linklists['footer'].links limit: 2 %}
      <a href="{{ link.url }}" class="nav-contact-link">{{ link.title }}</a>
      {% endfor %}
    {% else %}
    <a href="/pages/contact" class="nav-contact-link">Help &amp; Support</a>
    <a href="/pages/contact" class="nav-contact-link">Feedback &amp; Suggestions</a>
    {% endif %}
  </div>

</nav>
<div class="nav-overlay" data-nav-overlay></div>

<script>
(function(){
  var container=document.getElementById('nav-collections');
  var navLinks=document.querySelectorAll('[data-nav-collection-handle]');
  var handles=[];
  {% for link in linklists[section.settings.menu].links %}
    {% if link.url contains '/collections/' %}
      handles.push({url:{{ link.url | json }},title:{{ link.title | json }},handle:{{ link.url | split: '/collections/' | last | split: '?' | first | split: '/' | first | json }}});
    {% endif %}
  {% endfor %}
  if(!handles.length)return;

  var scrollHtml='<div class="nav-collections__scroll">';
  var loaded=0;
  var total=handles.length;

  function renderScroll(){
    scrollHtml+='</div>';
    if(container)container.innerHTML=scrollHtml;
  }

  handles.forEach(function(item){
    if(!item.handle){loaded++;if(loaded>=total)renderScroll();return;}
    fetch('/collections/'+encodeURIComponent(item.handle)+'.json')
      .then(function(r){if(!r.ok)throw new Error(r.status);return r.json()})
      .then(function(data){
        var col=data.collection;
        var img=col.image?col.image.src:null;
        if(!img&&col.products&&col.products.length){
          for(var i=0;i<col.products.length;i++){
            if(col.products[i].images&&col.products[i].images.length){img=col.products[i].images[0].src;break;}
          }
        }
        if(img){
          var navLink=document.querySelector('[data-nav-collection-handle="'+item.handle+'"]');
          if(navLink){
            var thumb=navLink.querySelector('.nav-link__thumb');
            if(thumb){thumb.innerHTML='<img src="'+img+'" alt="" width="40" height="40">';thumb.style.display='';}
          }
          scrollHtml+='<a href="'+item.url+'" class="nav-collections__item">'
            +'<div class="nav-collections__img-wrap">'
            +'<img src="'+img+'" alt="'+col.title+'" loading="lazy" width="140" height="180">'
            +'</div>'
            +'<span class="nav-collections__label">'+col.title+'</span></a>';
        }
      })
      .catch(function(){})
      .finally(function(){loaded++;if(loaded>=total)renderScroll()});
  });
})();
</script>

</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Account for announcement bar height",
      "default": true
    },
    {
      "type": "header",
      "content": "Utility Bar"
    },
    {
      "type": "checkbox",
      "id": "show_utility_bar",
      "label": "Show utility bar",
      "default": true
    },
    {
      "type": "text",
      "id": "utility_link_1_label",
      "label": "Utility link 1 label",
      "default": "Offers"
    },
    {
      "type": "url",
      "id": "utility_link_1_url",
      "label": "Utility link 1 URL"
    },
    {
      "type": "text",
      "id": "utility_link_2_label",
      "label": "Utility link 2 label",
      "default": "New Arrivals"
    },
    {
      "type": "url",
      "id": "utility_link_2_url",
      "label": "Utility link 2 URL"
    },
    {
      "type": "text",
      "id": "utility_link_3_label",
      "label": "Utility link 3 label",
      "default": "Best Sellers"
    },
    {
      "type": "url",
      "id": "utility_link_3_url",
      "label": "Utility link 3 URL"
    },
    {
      "type": "text",
      "id": "utility_link_4_label",
      "label": "Utility link 4 label (right side)",
      "default": "Track Order"
    },
    {
      "type": "url",
      "id": "utility_link_4_url",
      "label": "Utility link 4 URL"
    },
    {
      "type": "text",
      "id": "utility_link_5_label",
      "label": "Utility link 5 label (right side)",
      "default": "Contact Us"
    },
    {
      "type": "url",
      "id": "utility_link_5_url",
      "label": "Utility link 5 URL"
    }
  ],
  "blocks": [
    {
      "type": "mobile_category",
      "name": "Mobile Category Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Men"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Header",
      "blocks": [
        { "type": "mobile_category", "settings": { "label": "Men" } },
        { "type": "mobile_category", "settings": { "label": "Women" } },
        { "type": "mobile_category", "settings": { "label": "New In" } },
        { "type": "mobile_category", "settings": { "label": "Sale" } }
      ]
    }
  ]
}
{% endschema %}
