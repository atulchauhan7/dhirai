{% if section.settings.show_section %}
<div class="pincode-bar" id="pincode-bar" data-pincode-bar>
  <div class="pincode-bar__inner container">
    <button class="pincode-bar__btn" data-pincode-toggle aria-expanded="false" aria-controls="pincode-modal" aria-haspopup="dialog">
      <svg class="pincode-bar__pin-icon" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
      <span class="pincode-bar__label" data-pincode-label>{{ section.settings.placeholder | default: 'Enter Pincode' }}</span>
      <span class="pincode-bar__sub">for delivery</span>
      <svg class="pincode-bar__chevron" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
    </button>
  </div>
</div>

<div class="pincode-modal" id="pincode-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Enter delivery pincode" aria-labelledby="pincode-modal-title">
  <div class="pincode-modal__backdrop" data-pincode-close></div>
  <div class="pincode-modal__box">
    <div class="pincode-modal__head">
      <span class="pincode-modal__title" id="pincode-modal-title">Enter Delivery Pincode</span>
      <button class="pincode-modal__close" data-pincode-close aria-label="Close pincode modal">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div class="pincode-modal__body">
      <div class="pincode-modal__input-wrap">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
        <input type="number" class="pincode-modal__input" id="pincode-input" placeholder="e.g. 110001" maxlength="6" inputmode="numeric" pattern="[0-9]{6}" aria-label="6-digit pincode">
        <button class="pincode-modal__check-btn" type="button" data-pincode-check>Check</button>
      </div>
      <p class="pincode-modal__result" id="pincode-result" aria-live="polite" role="status"></p>
    </div>
  </div>
</div>
{% endif %}

{% schema %}
{
  "name": "Pincode Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show pincode bar",
      "default": true
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Placeholder text",
      "default": "Enter Pincode"
    }
  ],
  "presets": [{"name": "Pincode Bar"}]
}
{% endschema %}
