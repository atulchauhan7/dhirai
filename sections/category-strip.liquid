{% if section.blocks.size > 0 %}
<nav class="category-strip" aria-label="Shop by category">
  <div class="category-strip__track">
    {% for block in section.blocks %}
    <a href="{{ block.settings.link | default: '#' }}" class="category-strip__item" {{ block.shopify_attributes }}>
      <div class="category-strip__img-wrap">
        {% if block.settings.image != blank %}
        <img
          src="{{ block.settings.image | image_url: width: 160 }}"
          alt="{{ block.settings.label | escape }}"
          width="80"
          height="80"
          loading="lazy"
          decoding="async"
        >
        {% else %}
        {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>
      <span class="category-strip__label">{{ block.settings.label }}</span>
    </a>
    {% endfor %}
  </div>
</nav>
{% elsif request.design_mode %}
<div class="category-strip category-strip--empty">
  <p style="text-align:center;padding:1rem;font-size:0.75rem;color:#888;">Category Strip — add category blocks to get started</p>
</div>
{% endif %}

{% schema %}
{
  "name": "Category Strip",
  "max_blocks": 16,
  "settings": [],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Strip",
      "blocks": [
        { "type": "category", "settings": { "label": "New Arrivals" } },
        { "type": "category", "settings": { "label": "Best Sellers" } },
        { "type": "category", "settings": { "label": "Dresses" } },
        { "type": "category", "settings": { "label": "Tops" } },
        { "type": "category", "settings": { "label": "Sale" } }
      ]
    }
  ]
}
{% endschema %}
