<nav class="bottom-nav" id="bottom-nav" aria-label="Site navigation">

  <a href="{{ routes.root_url }}"
     class="bottom-nav__item{% if template.name == 'index' %} active{% endif %}"
     aria-label="Home"
     aria-current="{% if template.name == 'index' %}page{% else %}false{% endif %}">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
    <span>Home</span>
  </a>

  <a href="{{ routes.collections_url }}"
     class="bottom-nav__item{% if template.name == 'list-collections' or template.name == 'collection' %} active{% endif %}"
     aria-label="Collections"
     aria-current="{% if template.name == 'list-collections' or template.name == 'collection' %}page{% else %}false{% endif %}">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
    <span>Categories</span>
  </a>

  <a href="{{ routes.search_url }}?q=new+arrivals&type=product"
     class="bottom-nav__item bottom-nav__item--new"
     aria-label="New Arrivals">
    <span class="bottom-nav__new-pip" aria-hidden="true">New</span>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
    <span>New</span>
  </a>

  <a href="{{ routes.account_url }}"
     class="bottom-nav__item{% if request.path contains '/account' %} active{% endif %}"
     aria-label="My Account"
     aria-current="{% if request.path contains '/account' %}page{% else %}false{% endif %}">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
    <span>Profile</span>
  </a>

</nav>
